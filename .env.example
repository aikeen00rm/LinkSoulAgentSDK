# Fixture mode is runnable without credentials. Recreate the container after changes.
STUDIO_MODE=fixture
STUDIO_PORT=8000
# Compose always sets /data; local Python runs default to ./data.
STUDIO_DATA_DIR=./data
STUDIO_FRESH_SECONDS=30
STUDIO_PRESENCE_SECONDS=60
STUDIO_LOG_BYTES=1048576
STUDIO_LOG_BACKUPS=5
# Isolated ASR-text -> LLM agent. M1 remains connection-only; enable replies explicitly in M2.
LINKSOUL_GATEWAY=
LINKSOUL_APP_ID=
LINKSOUL_APP_KEY=
LINKSOUL_APP_SECRET=
# Optional filter. Blank selects the first online agent for this service run.
LINKSOUL_AGENT_ID=

# Minimal real text provider; no credentials needed for a local Ollama server.
STUDIO_REPLY_PROVIDER=disabled
# Docker Desktop reaches a host provider via this name. Local Python: http://127.0.0.1:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
# Oldest sessions are removed independently in each mode at the session limit.
STUDIO_MAX_SESSIONS=100
STUDIO_MAX_TURNS=200
STUDIO_MAX_TEXT=8192
