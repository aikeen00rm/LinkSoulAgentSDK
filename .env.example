# Optional in Compose fixture mode. Copy to .env for robot settings or local uv runs.
# Compose host port (use 8001 if the local Python service already uses 8000).
STUDIO_PORT=8000
STUDIO_MODE=fixture
STUDIO_DATA_DIR=./data
STUDIO_STALE_SECONDS=30
STUDIO_PRESENCE_SECONDS=60
STUDIO_LOG_BYTES=1048576
STUDIO_LOG_BACKUPS=5
# Robot mode requires an isolated ASR-text → LLM test agent.
# Confirm your regional endpoint with your LinkSoul administrator.
LINKSOUL_GATEWAY=
LINKSOUL_APP_ID=
LINKSOUL_APP_KEY=
LINKSOUL_APP_SECRET=
# Optional: leave blank to select the first agent reported online for this service run.
# Set an ID only to filter a specific agent.
LINKSOUL_AGENT_ID=
