# Copy to .env, edit on the server, and load using the README procedure.
STUDIO_MODE=fixture
STUDIO_DATA_DIR=./data
STUDIO_STALE_SECONDS=30
STUDIO_PRESENCE_SECONDS=60
STUDIO_LOG_BYTES=1048576
